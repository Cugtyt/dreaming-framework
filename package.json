{
  "name": "dreaming-framework",
  "version": "0.1.0",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./extensions/codex": {
      "types": "./dist/extensions/codex/index.d.ts",
      "import": "./dist/extensions/codex/index.js"
    },
    "./extensions/dsh": {
      "types": "./dist/extensions/dsh/index.d.ts",
      "import": "./dist/extensions/dsh/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "26.6.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ai": "^7.0.118",
    "zod": "^4.6.5"
  },
  "license": "MIT"
}
